# Velora Production Environment Variables - Template
# Copy this file to .env and fill in the actual production values. Never commit secrets to git.

# Server Configuration
PORT=3000
NODE_ENV=production
CLIENT_URL=http://localhost:8080

# Database Configuration (PostgreSQL)
# Standard Drizzle DB & Application Variables
SQL_HOST=postgres
SQL_DB_NAME=velora_db
SQL_USER=velora_user
SQL_PASSWORD=super_secure_password_here
SQL_ADMIN_USER=velora_admin
SQL_ADMIN_PASSWORD=super_secure_admin_password_here

# Unified connection string (Optional / Required by some external tools)
DATABASE_URL=postgresql://velora_user:super_secure_password_here@postgres:5432/velora_db

# Redis Configuration (Optional / Highly Recommended for Caching & Sessions)
REDIS_URL=redis://redis:6379

# JWT Security
JWT_SECRET=super_secure_token_secret_hash_value_here
JWT_REFRESH_SECRET=super_secure_refresh_token_secret_hash_value_here
SESSION_SECRET=super_secure_session_secret_hash_value_here

# AI Integrations
# Required for Google Gemini API server-side features
GEMINI_API_KEY=AIzaSy...

# Email Services (SMTP - Failback)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=smtp_password_here

# Email Services (Resend - Primary)
RESEND_API_KEY=re_your_api_key_here

# Security & Verification CAPTCHA
# Cloudflare Turnstile Configuration
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Telegram Integration (Ecosystem Bot & Community verification)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHANNEL_ID=-100123456789

# Initial Admin Seeding (Secure Configuration)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@velora.io
ADMIN_PASSWORD=change_this_to_a_secure_password_in_production
