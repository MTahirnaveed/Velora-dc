# =========================================================
# Stage 1: Build Phase
# =========================================================
FROM node:20-alpine AS builder

# Set build directory
WORKDIR /app

# Enable caching of node_modules
COPY package*.json ./
RUN npm ci

# Copy the rest of the application files
COPY . .

# Set environment variables for production build
ENV NODE_ENV=production

# Compile static assets (vite build creates the static bundle inside /app/dist)
RUN npm run build

# =========================================================
# Stage 2: Production Serving Phase (Nginx Unprivileged)
# =========================================================
FROM nginxinc/nginx-unprivileged:alpine

# Copy static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy our optimized, production-grade Nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Port 8080 is the default and standard port for unprivileged Nginx containers
EXPOSE 8080

# Production Health Check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
